{
    "name": "social_media",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "npx tsx server.ts",
        "dev:next": "next dev",
        "build": "npm run postinstall & next build && npm run server:build",
        "start": "node dist-server/server.js",
        "start:next": "next start",
        "server:build": "npx tsc server.ts lib/socketServer.ts lib/watch.ts --outDir dist-server --esModuleInterop --module commonjs --moduleResolution node --skipLibCheck",
        "lint": "next lint",
        "test": "jest",
        "podman-compose": "podman compose up -d & podman compose -f docker-compose-elasticsearch.yml up -d & podman compose -f docker-compose-kafka.yml up -d",
        "strapi": "podman compose -f docker-compose-strapi.yml up -d",
        "postinstall": "prisma generate",
        "export": "next export",
        "socket": "npx tsx socket-server.ts",
        "socket:build": "npx tsc socket-server.ts lib/socketServer.ts lib/watch.ts --outDir dist-socket --esModuleInterop --module commonjs --moduleResolution node --skipLibCheck",
        "socket:start": "node dist-socket/socket-server.js"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.4.2",
        "@elastic/elasticsearch": "^8.15.0",
        "@emotion/react": "^11.13.3",
        "@emotion/styled": "^11.13.0",
        "@faker-js/faker": "^9.0.0",
        "@mui/icons-material": "^6.0.2",
        "@mui/material": "^6.0.2",
        "@next-auth/prisma-adapter": "^1.0.7",
        "@prisma/client": "^5.19.1",
        "@supabase/supabase-js": "^2.57.2",
        "@upstash/redis": "^1.37.0",
        "axios": "^1.13.5",
        "bcryptjs": "^2.4.3",
        "kafkajs": "^2.2.4",
        "moment": "^2.30.1",
        "mongoose": "^8.9.5",
        "multer": "^1.4.5-lts.1",
        "next": "15.5.12",
        "next-auth": "^4.24.7",
        "react": "^18",
        "react-dom": "^18",
        "react-hook-form": "^7.53.0",
        "redis": "^4.7.0",
        "social_media": "file:",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "vitest": "^4.1.0"
    },
    "devDependencies": {
        "@babel/core": "^7.26.10",
        "@babel/preset-env": "^7.26.10",
        "@types/bcrypt": "^5.0.2",
        "@types/multer": "^1.4.12",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "babel-jest": "^29.7.0",
        "eslint": "^8",
        "eslint-config-next": "15.5.12",
        "jest": "^29.7.0",
        "node-mocks-http": "^1.15.1",
        "postcss": "^8",
        "prisma": "^5.19.0",
        "supertest": "^7.0.0",
        "tailwindcss": "^3.4.1",
        "ts-jest": "^29.2.5",
        "typescript": "^5"
    },
    "optionalDependencies": {
        "bufferutil": "^4.1.0",
        "utf-8-validate": "^6.0.6"
    },
    "overrides": {
        "glob": "^10.5.0"
    }
}
